# 해당 파일을 .env 파일로 복사한 뒤 값을 채운다.
# KEY=VALUE 형식만 읽어들이므로 값에 따옴표를 붙이지 않는다.

# 사용할 환경: demo(모의) 또는 real(실전)
NH_ENV=demo

NH_DEMO_URL=https://apidemo.futures.co.kr
NH_REAL_URL=https://api.futures.co.kr

# 국내선물
NH_DOMESTIC_DEMO_APP_KEY=
NH_DOMESTIC_DEMO_APP_SECRET=
NH_DOMESTIC_DEMO_ACCOUNT=

NH_DOMESTIC_REAL_APP_KEY=
NH_DOMESTIC_REAL_APP_SECRET=
NH_DOMESTIC_REAL_ACCOUNT=

# 해외선물
NH_OVERSEAS_DEMO_APP_KEY=
NH_OVERSEAS_DEMO_APP_SECRET=
NH_OVERSEAS_DEMO_ACCOUNT=

NH_OVERSEAS_REAL_APP_KEY=
NH_OVERSEAS_REAL_APP_SECRET=
NH_OVERSEAS_REAL_ACCOUNT=
